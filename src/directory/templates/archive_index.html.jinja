{% extends "base.html.jinja" %}
{% block title %}{{ t.archive_index_title }} — {{ t.site_title }}{% endblock %}
{% block header_right %}<a href="/">{{ t.back_home }}</a>{% endblock %}

{% block content %}
<div class="card">
  <h1 style="margin-top:0;">{{ t.archive_index_title }}</h1>
  <p class="muted" style="margin-bottom:0;">{{ t.archive_index_intro }}</p>
</div>

{% for section in sections %}
<div class="card">
  <h2 style="margin-top:0;">{{ section.heading }}</h2>
  {% if section.periods %}
  <ul class="archive-month-list">
    {% for p in section.periods %}
    <li><a href="/archive/{{ section.granularity }}/{{ p.period_key }}/">{{ p.label }}</a></li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="muted" style="margin:0;">{{ t.archive_no_periods }}</p>
  {% endif %}
</div>
{% endfor %}
{% endblock %}
