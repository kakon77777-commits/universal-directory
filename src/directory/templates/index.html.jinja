{% extends "base.html.jinja" %}
{% block title %}{{ t.index_title }}{% endblock %}
{% block header_right %}{{ t.generated_at_label }}{{ generated_at }}{% endblock %}

{% block content %}
<div class="card">
  <p class="muted" style="margin-top:0;">
    {{ t.index_intro.format(profile_version=profile_version) }}
  </p>
</div>

{% for cat in categories %}
<div class="card">
  <h2 style="margin-top:0;"><a href="/categories/{{ cat.category_id }}/">{{ cat.name }}</a>
    <span class="muted" style="font-weight:400; font-size:0.85rem;">({{ cat.count }} {{ t.items_suffix }})</span>
  </h2>
  <p class="muted" style="margin-top:-0.5rem;">{{ cat.definition }}</p>
  <ul class="rank-list">
    {% for e in cat.top_entities %}
    <li>
      <div>
        <span class="rank-num">#{{ e.rank }}</span>
        <a href="/entities/{{ e.slug }}/">{{ e.canonical_name }}</a>
        <div class="muted" style="font-size:0.85rem;">{{ e.tagline }}</div>
      </div>
      <span class="score">{{ e.score }}</span>
    </li>
    {% endfor %}
  </ul>
  <p style="margin-bottom:0;"><a href="/categories/{{ cat.category_id }}/">{{ t.view_full_ranking }}</a></p>
</div>
{% endfor %}
{% endblock %}
