{% extends "base.html.jinja" %}
{% block title %}{{ category.name }} — {{ t.site_title }}{% endblock %}
{% block header_right %}<a href="/">{{ t.back_home }}</a>{% endblock %}

{% block content %}
<div class="card">
  <h1 style="margin-top:0;">{{ category.name }}</h1>
  <p class="muted">{{ category.definition }}</p>
  <p class="methodology">
    {{ t.methodology.format(profile_version=profile_version, generated_at=generated_at) }}
  </p>
</div>

<div class="card">
  <table>
    <thead>
      <tr><th>{{ t.th_rank }}</th><th>{{ t.th_name }}</th><th>{{ t.th_score }}</th><th>{{ t.th_notes }}</th></tr>
    </thead>
    <tbody>
      {% for e in entities %}
      <tr>
        <td class="muted">{{ e.rank }}</td>
        <td>
          <a href="/entities/{{ e.slug }}/">{{ e.canonical_name }}</a>
          <div class="muted" style="font-size:0.85rem;">{{ e.tagline }}</div>
        </td>
        <td class="score">{{ e.score }}</td>
        <td class="factors">
          {% for p in e.positive_factors %}<div class="pos">+ {{ p }}</div>{% endfor %}
          {% for n in e.negative_factors %}<div class="neg">- {{ n }}</div>{% endfor %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
